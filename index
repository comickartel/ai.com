<style>
/* =========================================================
   RAYOLLA NEXUS AI // COMMAND CONSOLE v3 - ELITE EDITION
========================================================= */

:root {
    --cyan: #00f5ff;
    --cyan2: #00a8ff;
    --green: #39ff88;
    --blue: #168cff;
    --purple: #9b5cff;
    --yellow: #ffe66d;
    --orange: #ff9d3d;
    --red: #ff3d71;

    --bg: #010406;
    --panel: rgba(2, 10, 15, .95);
    --panel2: rgba(4, 16, 23, .95);

    --border: rgba(0,245,255,.22);
    --border-bright: rgba(0,245,255,.6);

    --text: #eaffff;
    --muted: #66858d;
    --muted2: #41636b;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    overflow-x: hidden;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--text);
    background: var(--bg);
}

/* =========================================================
   BACKGROUND & FX
========================================================= */

.background {
    position: fixed;
    inset: 0;
    z-index: -20;
    overflow: hidden;
    background: 
        radial-gradient(circle at 50% 10%, rgba(0,245,255,.13), transparent 35%),
        radial-gradient(circle at 5% 90%, rgba(57,255,136,.08), transparent 30%),
        radial-gradient(circle at 100% 50%, rgba(155,92,255,.08), transparent 30%),
        linear-gradient(135deg, #010406, #000203 70%);
}

.scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to bottom, transparent 0, transparent 3px, rgba(0,255,255,.02) 4px);
    pointer-events: none;
}

.grid {
    position: absolute;
    width: 180%;
    height: 100%;
    left: -40%;
    top: 30%;
    opacity: .14;
    background-image: 
        linear-gradient(rgba(0,245,255,.18) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,245,255,.18) 1px, transparent 1px);
    background-size: 48px 48px;
    transform: perspective(650px) rotateX(62deg);
    transform-origin: center top;
    animation: gridMove 7s linear infinite;
}

@keyframes gridMove {
    from { transform: perspective(650px) rotateX(62deg) translateY(0); }
    to { transform: perspective(650px) rotateX(62deg) translateY(48px); }
}

.glow {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    filter: blur(140px);
    opacity: .25;
    animation: glowMove 11s ease-in-out infinite alternate;
}

.glow.one { left: -220px; top: -220px; background: var(--cyan); }
.glow.two { right: -240px; bottom: -230px; background: var(--purple); animation-delay: 2s; }

@keyframes glowMove {
    from { transform: translate(0,0) scale(1); }
    to { transform: translate(90px,70px) scale(1.25); }
}

.particles {
    position: fixed;
    inset: 0;
    z-index: -10;
    pointer-events: none;
}

.particle {
    position: absolute;
    width: 2px;
    height: 2px;
    background: var(--cyan);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--cyan);
    animation: particleUp linear infinite;
}

@keyframes particleUp {
    from { transform: translateY(110vh); opacity: 0; }
    20% { opacity: .9; }
    80% { opacity: .4; }
    to { transform: translateY(-10vh); opacity: 0; }
}

/* =========================================================
   APP CONTAINER
========================================================= */

.app {
    width: min(1240px, 96%);
    min-height: 94vh;
    margin: 3vh auto;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: linear-gradient(145deg, rgba(3,15,22,.96), rgba(1,6,10,.96));
    border: 1px solid var(--border);
    border-radius: 18px;
    backdrop-filter: blur(24px);
    box-shadow: 0 0 90px rgba(0,220,255,.08), 0 30px 100px rgba(0,0,0,.6), inset 0 0 80px rgba(0,245,255,.02);
}

/* TOP BAR */
.topbar {
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 18px;
    color: var(--muted);
    font-family: "Courier New", monospace;
    font-size: 10px;
    letter-spacing: 1.3px;
    border-bottom: 1px solid rgba(0,245,255,.09);
    background: rgba(0,0,0,.3);
}

.topbar-left, .topbar-right {
    display: flex;
    align-items: center;
    gap: 14px;
}

.system-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 10px var(--green);
}

/* HEADER */
.header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
    border-bottom: 1px solid var(--border);
    background: rgba(2,11,16,.85);
}

.brand {
    display: flex;
    align-items: center;
    gap: 16px;
}

.logo {
    position: relative;
    width: 58px;
    height: 66px;
    flex-shrink: 0;
    clip-path: polygon(50% 0, 94% 16%, 87% 70%, 50% 100%, 13% 70%, 6% 16%);
    background: linear-gradient(145deg, var(--cyan), var(--blue) 50%, #07151f 51%);
    filter: drop-shadow(0 0 8px var(--cyan)) drop-shadow(0 0 20px rgba(0,245,255,.4));
    animation: shieldPulse 3s infinite;
}

.logo::before {
    content: "";
    position: absolute;
    inset: 7px;
    clip-path: polygon(50% 0, 94% 16%, 87% 70%, 50% 100%, 13% 70%, 6% 16%);
    background: #040d14;
}

.logo::after {
    content: "RN";
    position: absolute;
    left: 14px;
    top: 22px;
    color: var(--cyan);
    font-family: "Courier New", monospace;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    text-shadow: 0 0 8px var(--cyan);
}

@keyframes shieldPulse {
    0%, 85%, 100% { transform: scale(1); }
    90% { transform: scale(1.07); filter: brightness(1.6) drop-shadow(0 0 14px var(--cyan)); }
}

.brand h1 {
    font-size: 25px;
    letter-spacing: 3px;
    font-family: "Courier New", monospace;
}

.brand h1 span {
    color: var(--cyan);
    text-shadow: 0 0 10px var(--cyan), 0 0 25px rgba(0,245,255,.5);
}

.brand small {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font-family: "Courier New", monospace;
    font-size: 10px;
    letter-spacing: 1.2px;
}

/* HEADER RIGHT ACTIONS */
.header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
}

.status {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 14px;
    color: var(--green);
    border: 1px solid rgba(57,255,136,.2);
    border-radius: 999px;
    background: rgba(57,255,136,.04);
    font-family: "Courier New", monospace;
    font-size: 10px;
    letter-spacing: 1.4px;
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 12px var(--green);
    animation: statusPulse 1.2s infinite;
}

@keyframes statusPulse {
    50% { opacity: .3; transform: scale(.6); }
}

/* COMIC HACKER HUB EXTERNAL BUTTON */
.external-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    color: var(--bg);
    background: linear-gradient(135deg, var(--cyan), var(--green));
    border: none;
    border-radius: 8px;
    font-family: "Courier New", monospace;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 0 20px rgba(0,245,255,.3);
    transition: .2s;
}

.external-btn:hover {
    transform: scale(1.04);
    box-shadow: 0 0 30px rgba(0,245,255,.6);
}

/* MODULE BAR */
.modules {
    display: flex;
    gap: 8px;
    padding: 12px 24px;
    overflow-x: auto;
    border-bottom: 1px solid rgba(0,245,255,.09);
    background: rgba(0,0,0,.18);
}

.modules::-webkit-scrollbar { height: 4px; }
.modules::-webkit-scrollbar-thumb { background: var(--border); }

.module {
    flex-shrink: 0;
    padding: 6px 12px;
    color: #6d9ca4;
    border: 1px solid rgba(0,245,255,.12);
    border-radius: 6px;
    font-family: "Courier New", monospace;
    font-size: 10px;
    letter-spacing: 1px;
    cursor: pointer;
    transition: .2s;
}

.module:hover, .module.active {
    color: var(--cyan);
    border-color: rgba(0,245,255,.45);
    background: rgba(0,245,255,.06);
    box-shadow: 0 0 15px rgba(0,245,255,.12);
}

/* TOOLBAR */
.toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 24px;
    border-bottom: 1px solid rgba(0,245,255,.08);
    color: var(--muted);
    font-family: "Courier New", monospace;
    font-size: 9px;
}

.toolbar-left {
    display: flex;
    gap: 10px;
}

.tool-btn {
    padding: 6px 11px;
    color: #72a0a8;
    background: transparent;
    border: 1px solid rgba(0,245,255,.14);
    border-radius: 5px;
    cursor: pointer;
    font-family: inherit;
    font-size: 9px;
    transition: .2s;
}

.tool-btn:hover {
    color: var(--cyan);
    border-color: rgba(0,245,255,.4);
    background: rgba(0,245,255,.06);
}

/* CHAT AREA */
.chat {
    flex: 1;
    min-height: 520px;
    max-height: 60vh;
    overflow-y: auto;
    padding: 30px 26px;
}

.chat::-webkit-scrollbar { width: 6px; }
.chat::-webkit-scrollbar-track { background: transparent; }
.chat::-webkit-scrollbar-thumb { background: #123b43; border-radius: 20px; }

.message {
    display: flex;
    gap: 14px;
    margin-bottom: 24px;
    animation: messageIn .28s ease;
}

@keyframes messageIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

.message.user {
    justify-content: flex-end;
}

.avatar {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #071c23;
    border: 1px solid rgba(0,245,255,.35);
    box-shadow: 0 0 15px rgba(0,245,255,.1);
    font-size: 18px;
}

.user .avatar {
    order: 2;
    background: #0b1724;
    border-color: rgba(60,150,255,.4);
}

.bubble {
    position: relative;
    max-width: min(840px, 86%);
    padding: 18px 20px;
    color: #e3ffff;
    line-height: 1.68;
    font-size: 14px;
    background: linear-gradient(145deg, rgba(7,28,36,.94), rgba(4,18,25,.94));
    border: 1px solid rgba(0,245,255,.16);
    border-radius: 6px 16px 16px 16px;
    box-shadow: 0 15px 40px rgba(0,0,0,.25);
}

.user .bubble {
    background: linear-gradient(145deg, rgba(10,33,54,.96), rgba(6,21,38,.96));
    border: 1px solid rgba(60,150,255,.3);
    border-radius: 16px 6px 16px 16px;
}

.response-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
}

.module-tag {
    display: inline-block;
    padding: 5px 9px;
    color: var(--cyan);
    background: rgba(0,245,255,.06);
    border: 1px solid rgba(0,245,255,.25);
    border-radius: 4px;
    font-family: "Courier New", monospace;
    font-size: 9px;
    letter-spacing: 1.1px;
}

.threat {
    padding: 4px 8px;
    border-radius: 4px;
    font-family: "Courier New", monospace;
    font-size: 8px;
    letter-spacing: 1px;
}

.threat.info { color: var(--green); border: 1px solid rgba(57,255,136,.25); background: rgba(57,255,136,.05); }
.threat.medium { color: var(--yellow); border: 1px solid rgba(255,230,109,.25); background: rgba(255,230,109,.05); }
.threat.high { color: var(--red); border: 1px solid rgba(255,61,113,.25); background: rgba(255,61,113,.05); }

.cyber-title {
    margin-bottom: 10px;
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: .4px;
}

.vocab {
    margin: 14px 0;
    padding: 13px;
    background: rgba(0,0,0,.25);
    border-left: 2px solid var(--cyan);
    font-family: "Courier New", monospace;
    font-size: 11px;
}

.vocab-row {
    display: grid;
    grid-template-columns: 155px 1fr;
    gap: 10px;
    margin: 6px 0;
}

.vocab-key { color: var(--green); }
.vocab-value { color: #97c0c7; }

/* TERMINAL CODE BLOCKS */
.terminal-block {
    margin: 14px 0;
    background: #02070a;
    border: 1px solid rgba(0,245,255,.2);
    border-radius: 6px;
    overflow: hidden;
    font-family: "Courier New", monospace;
}

.terminal-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 12px;
    background: #05141c;
    border-bottom: 1px solid rgba(0,245,255,.15);
    font-size: 10px;
    color: var(--muted);
}

.terminal-dots {
    display: flex;
    gap: 5px;
}

.terminal-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #33545e;
}
.terminal-dots span:nth-child(1) { background: var(--red); }
.terminal-dots span:nth-child(2) { background: var(--yellow); }
.terminal-dots span:nth-child(3) { background: var(--green); }

.terminal-content {
    padding: 12px 14px;
    color: #5afcd6;
    font-size: 12px;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-x: auto;
}

.tip {
    margin-top: 14px;
    padding: 12px 14px;
    color: #c4e6ea;
    background: linear-gradient(90deg, rgba(57,255,136,.06), transparent);
    border-left: 2px solid var(--green);
    font-size: 12px;
}

.tip b { color: var(--green); }

/* SUGGESTIONS */
.suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 26px 14px;
}

.suggestion {
    padding: 8px 12px;
    color: #9adce2;
    background: rgba(6,29,35,.7);
    border: 1px solid rgba(0,245,255,.16);
    border-radius: 6px;
    cursor: pointer;
    font-family: "Courier New", monospace;
    font-size: 10px;
    transition: .2s;
}

.suggestion:hover {
    color: #fff;
    border-color: var(--cyan);
    background: rgba(0,100,120,.35);
    box-shadow: 0 0 18px rgba(0,245,255,.18);
    transform: translateY(-2px);
}

/* INPUT AREA */
.input-area {
    padding: 16px 24px 20px;
    border-top: 1px solid rgba(0,245,255,.14);
    background: rgba(1,8,12,.9);
}

.input-box {
    display: flex;
    gap: 10px;
    padding: 8px;
    background: rgba(4,20,26,.98);
    border: 1px solid rgba(0,245,255,.25);
    border-radius: 10px;
    transition: .2s;
}

.input-box:focus-within {
    border-color: rgba(0,245,255,.7);
    box-shadow: 0 0 28px rgba(0,245,255,.12);
}

.prompt {
    display: flex;
    align-items: center;
    padding-left: 10px;
    color: var(--green);
    font-family: "Courier New", monospace;
    font-size: 13px;
}

#userInput {
    flex: 1;
    min-width: 0;
    padding: 12px 8px;
    color: #fff;
    background: transparent;
    border: none;
    outline: none;
    font-size: 14px;
}

#userInput::placeholder { color: #4b717b; }

#sendBtn {
    width: 52px;
    height: 44px;
    flex-shrink: 0;
    border: none;
    border-radius: 8px;
    color: #001012;
    background: linear-gradient(135deg, var(--cyan), var(--green));
    cursor: pointer;
    font-size: 18px;
    font-weight: bold;
    box-shadow: 0 0 20px rgba(0,245,255,.28);
    transition: .2s;
}

#sendBtn:hover { transform: scale(1.05); box-shadow: 0 0 30px rgba(0,245,255,.55); }

.footer {
    display: flex;
    justify-content: space-between;
    margin-top: 9px;
    color: #3b5a63;
    font-family: "Courier New", monospace;
    font-size: 8px;
    letter-spacing: .8px;
}
</style>
</head>

