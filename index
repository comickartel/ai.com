        <div class="cyber-title">OPERATIONAL SECURITY DIRECTIVE</div>
        <div class="tip"><b>DIRECTIVE //</b> ${tip}</div>
    `, true);
}

function filterModule(modName) {
    document.querySelectorAll('.module').forEach(m => m.classList.remove('active'));
    event.target.classList.add('active');
    if(modName === 'ALL') {
        askSuggestion('Show me all core security modules');
    } else {
        askSuggestion('Explain ' + modName.toLowerCase());
    }
}
