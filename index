/* =========================================================
   CHAT ENGINE & LOGIC
========================================================= */
function addMessage(sender, htmlContent, isBot = true) {
    const msgDiv = document.createElement("div");
    msgDiv.className = `message ${isBot ? 'bot' : 'user'}`;

    if (isBot) {
        msgDiv.innerHTML = `<div class="avatar">🛡️</div><div class="bubble">${htmlContent}</div>`;
    } else {
        msgDiv.innerHTML = `<div class="avatar">👤</div><div class="bubble"><div style="color:#70aaff; font-family:'Courier New'; font-size:9px; margin-bottom:6px;">OPERATOR // QUERY</div><p>${escapeHTML(htmlContent)}</p></div>`;
    }

    chat.appendChild(msgDiv);
    chat.scrollTop = chat.scrollHeight;
}

function processQuery(queryText) {
    if (!queryText.trim()) return;

    addMessage("user", queryText, false);
    input.value = "";

    const typingDiv = document.createElement("div");
    typingDiv.className = "message bot";
    typingDiv.innerHTML = `
        <div class="avatar">🛡️</div>
        <div class="bubble">
            <div style="display:flex; align-items:center; gap:10px; color:#547b83; font-family:'Courier New'; font-size:9px; letter-spacing:1px;">
                <span>ANALYZING INTELLIGENCE MATRIX</span>
                <div style="display:flex; gap:4px;">
                    <span style="width:6px; height:6px; background:var(--cyan); border-radius:50%; animation:statusPulse 1s infinite;"></span>
                    <span style="width:6px; height:6px; background:var(--cyan); border-radius:50%; animation:statusPulse 1s infinite .2s;"></span>
                    <span style="width:6px; height:6px; background:var(--cyan); border-radius:50%; animation:statusPulse 1s infinite .4s;"></span>
                </div>
            </div>
        </div>
    `;
    chat.appendChild(typingDiv);
    chat.scrollTop = chat.scrollHeight;

    setTimeout(() => {
        chat.removeChild(typingDiv);

        const lowerQuery = queryText.toLowerCase();
        let matched = knowledge.find(item => 
            item.keywords.some(kw => lowerQuery.includes(kw))
        );

        if (matched) {
            const responseHTML = `
                <div class="response-header">
                    <span class="module-tag">${matched.module} // DATABASE MATCH</span>
                    <span class="threat ${matched.threat}">${matched.threat.toUpperCase()}</span>
                </div>
                <div class="cyber-title">${matched.title}</div>
                ${matched.answer}
            `;
            addMessage("bot", responseHTML, true);
        } else {
            const fallbackHTML = `
                <div class="response-header">
                    <span class="module-tag">CORE // SYNTHESIS</span>
                    <span class="threat info">INFO</span>
                </div>
                <div class="cyber-title">ANALYTICAL RESPONSE ARCHITECTURE</div>
                <p>Query parsed for: <strong>"${escapeHTML(queryText)}"</strong></p>
                <br>
                <p>The Rayolla Nexus AI engine synthesizes defensive and offensive principles across multiple vectors. Try querying terms like <em>OSINT, SQLi, XSS, Zero Trust, SIEM, Malware, Cryptography, Cloud Security, DFIR, or Python scripts</em>.</p>
                <div class="terminal-block">
                    <div class="terminal-titlebar"><span>status.log</span><div class="terminal-dots"><span></span><span></span><span></span></div></div>
                    <div class="terminal-content">[OK] Neural heuristic scan complete. No critical vulnerabilities found in query syntax.</div>
                </div>
                <div class="tip"><b>CONSOLE ADVICE //</b> Click any suggestion pill above or visit the Comic Hacker Hub button in the header.</div>
            `;
            addMessage("bot", fallbackHTML, true);
        }
    }, 850);
}

sendBtn.addEventListener("click", () => processQuery(input.value));
input.addEventListener("keypress", (e) => { if (e.key === "Enter") processQuery(input.value); });

function askSuggestion(text) {
    input.value = text;
    processQuery(text);
}

