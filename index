function showRandomTip() {
    const tips = [
        "Always enforce multi-factor authentication (MFA) across all administrative portals.",
        "Practice defense-in-depth: never rely solely on a single perimeter firewall.",
        "Conduct regular immutable backups and test your restoration procedures quarterly."
    ];
    const tip = tips[Math.floor(Math.random() * tips.length)];
    addMessage("bot", `
        <div class="response-header">
            <span class="module-tag">CORE // ADVISORY</span>
            <span class="threat info">TIP</span>
